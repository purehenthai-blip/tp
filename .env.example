# ToasterPants — Environment Variables
# Copy to .env and fill in production values

# ── Core ──────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here-min-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database (PostgreSQL for production) ──────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=toasterpants
DB_USER=toasterpants_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# ── Media Storage ─────────────────────────────────────────────────────────────
MEDIA_ROOT=/var/www/toasterpants/media

# ── Redis (for Celery background tasks) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password

# ── SSL (set True only when SSL is configured on your server) ─────────────────
SECURE_SSL_REDIRECT=False

# ── CORS (set to your frontend domain if using API separately) ────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Translation API (optional) ────────────────────────────────────────────────
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
